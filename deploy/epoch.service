# /etc/systemd/system/epoch.service
# sudo systemctl daemon-reload && sudo systemctl enable --now epoch
[Unit]
Description=Epoch · AI 专业生涯训练台
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/epoch
Environment=PYTHONUNBUFFERED=1
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/python3 /opt/epoch/server/app.py
Restart=always
RestartSec=3
# 安全加固
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/epoch/data

[Install]
WantedBy=multi-user.target
