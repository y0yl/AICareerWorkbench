# 复制为 .env 后填写（.env 不要提交到代码仓库）

# —— Qwen（阿里云百炼 / DashScope，OpenAI 兼容模式）——
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-plus
# 备用模型（逗号分隔）：主模型额度用尽 / 限流 / 不可用时依次切换
QWEN_FALLBACK_MODELS=qwen-flash,qwen-turbo
# 国际站请改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT=90
# 成绩单识别（视觉任务）用的模型
QWEN_VL_MODEL=qwen-vl-max
# 若使用 qwen3-xxx 开源系列模型，请设为 1（关闭思考模式，否则 JSON 任务会报错）
QWEN_DISABLE_THINKING=0

# —— 服务 ——
HOST=127.0.0.1
PORT=8080
# 部署在 nginx 之后设为 1（用 X-Real-IP 做限流）
TRUST_PROXY=0
# 数据目录（SQLite），默认项目下 data/
# DATA_DIR=/var/lib/epoch

# —— 保护 API 额度 ——
AI_RATE_PER_HOUR=60
AI_DAILY_CAP=3000
ALLOW_REGISTER=1
